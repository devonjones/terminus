      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - seestar_last_heard_timestamp_seconds",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
