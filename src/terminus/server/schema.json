{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Api",
  "description": "Every payload the sidecar sends. tests/test_server.py validates responses against it, and app/src/api/generated.ts is generated from it.",
  "type": "object",
  "properties": {
    "health": {
      "$ref": "#/$defs/Health"
    },
    "state": {
      "$ref": "#/$defs/AppState"
    },
    "sites": {
      "$ref": "#/$defs/SiteList"
    },
    "horizon": {
      "$ref": "#/$defs/Horizon"
    },
    "disc": {
      "$ref": "#/$defs/Disc"
    },
    "frames": {
      "$ref": "#/$defs/Frames"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Health": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "ok",
        "version"
      ],
      "additionalProperties": false
    },
    "AppState": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "site": {
          "anyOf": [
            {
              "$ref": "#/$defs/SiteSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "tab": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "object",
          "properties": {
            "link": {
              "type": "string"
            }
          },
          "required": [
            "link"
          ],
          "additionalProperties": false
        },
        "sun_mode": {
          "enum": [
            "sun",
            "shade"
          ]
        },
        "spin": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "description": "rough yaw of an unoriented site, degrees"
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/Job"
            },
            {
              "type": "null"
            }
          ]
        },
        "log": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "only in /dev/state"
        }
      },
      "required": [
        "version",
        "site",
        "tab",
        "tabs",
        "scope",
        "sun_mode",
        "spin",
        "job"
      ],
      "additionalProperties": false
    },
    "SiteSummary": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "photos": {
          "type": "integer"
        },
        "panorama": {
          "type": "boolean"
        },
        "mask": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "description": "the user's name for the site (the slug until renamed)"
        },
        "updated": {
          "type": "string",
          "description": "when anything in the site last changed (local time, ISO 8601, minutes)"
        }
      },
      "required": [
        "slug",
        "photos",
        "panorama",
        "mask",
        "name",
        "updated"
      ],
      "additionalProperties": false
    },
    "SiteList": {
      "type": "object",
      "properties": {
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SiteSummary"
          }
        }
      },
      "required": [
        "sites"
      ],
      "additionalProperties": false
    },
    "Job": {
      "type": "object",
      "properties": {
        "site": {
          "type": "string"
        },
        "step": {
          "enum": [
            "mosaic",
            "reblend",
            "skymask",
            "horizon",
            null
          ]
        },
        "status": {
          "enum": [
            "running",
            "done",
            "failed"
          ]
        },
        "log": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "enum": [
            "matching",
            "solving",
            "placing",
            "segmenting",
            "blending",
            "judging",
            null
          ],
          "description": "what the current step is doing"
        },
        "canvas": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[width, height] of the panorama being built"
            },
            {
              "type": "null"
            }
          ]
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BuildFrame"
          }
        },
        "active": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the photos being worked on right now"
        },
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pair"
          },
          "description": "photo pairs found to share matches, as cpfind reports them"
        },
        "compared": {
          "type": "integer",
          "description": "photo pairs compared so far"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "description": "what the phase is doing right now, in words (e.g. cpfind's own stages)"
        },
        "outline": {
          "type": "integer",
          "description": "times the horizon so far has been redrawn (fetch /site/progress.png when it changes)"
        }
      },
      "required": [
        "site",
        "step",
        "status",
        "log",
        "error",
        "phase",
        "canvas",
        "frames",
        "active",
        "pairs",
        "compared",
        "detail",
        "outline"
      ],
      "additionalProperties": false
    },
    "Solution": {
      "type": "object",
      "properties": {
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        },
        "tilt_mag": {
          "type": "number"
        },
        "tilt_dir": {
          "type": "number"
        }
      },
      "required": [
        "yaw",
        "pitch",
        "tilt_mag",
        "tilt_dir"
      ],
      "additionalProperties": false
    },
    "Column": {
      "type": "object",
      "properties": {
        "az": {
          "type": "number"
        },
        "alt": {
          "type": "number",
          "description": "the actual horizon"
        },
        "type": {
          "type": "string"
        },
        "planning": {
          "type": "number"
        },
        "fuzz": {
          "type": "number"
        },
        "bound": {
          "type": "boolean"
        },
        "clipped": {
          "type": "boolean"
        },
        "pockets": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[alt_hi, alt_lo]: sky seen below the line"
          }
        }
      },
      "required": [
        "az",
        "alt"
      ],
      "additionalProperties": false
    },
    "FitColumn": {
      "type": "object",
      "properties": {
        "az": {
          "type": "number"
        },
        "alt": {
          "type": "number"
        },
        "bound": {
          "type": "boolean"
        },
        "used": {
          "type": "boolean"
        },
        "residual": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "excluded_by": {
          "type": "string"
        }
      },
      "required": [
        "az"
      ],
      "additionalProperties": false
    },
    "Horizon": {
      "type": "object",
      "properties": {
        "mask": {
          "type": "string"
        },
        "oriented": {
          "type": "boolean"
        },
        "solution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Solution"
            },
            {
              "type": "null"
            }
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "fit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FitColumn"
          }
        },
        "settled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "backend": {
          "type": [
            "string",
            "null"
          ],
          "description": "the detector that read the horizon (e.g. \"heuristic\": no segmentation model ran)"
        }
      },
      "required": [
        "mask",
        "oriented",
        "solution",
        "columns",
        "fit",
        "settled",
        "backend"
      ],
      "additionalProperties": false
    },
    "XY": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "Disc": {
      "type": "object",
      "description": "Overlays for the polar disc, in disc pixels (N up, E right), from polar.disc_xy.",
      "properties": {
        "size": {
          "type": "integer"
        },
        "floor": {
          "type": "number"
        },
        "centre": {
          "type": "integer"
        },
        "rings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alt": {
                "type": "number"
              },
              "r": {
                "type": "number"
              }
            },
            "required": [
              "alt",
              "r"
            ],
            "additionalProperties": false
          }
        },
        "cardinals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "xy": {
                "$ref": "#/$defs/XY"
              }
            },
            "required": [
              "label",
              "xy"
            ],
            "additionalProperties": false
          }
        },
        "planning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XY"
          }
        },
        "fiducials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "az": {
                "type": "number"
              },
              "alt": {
                "type": "number"
              },
              "bound": {
                "type": "boolean"
              },
              "xy": {
                "$ref": "#/$defs/XY"
              }
            },
            "required": [
              "az",
              "alt",
              "bound",
              "xy"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "size",
        "floor",
        "centre",
        "rings",
        "cardinals",
        "planning",
        "fiducials"
      ],
      "additionalProperties": false
    },
    "Frame": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "layer": {
          "type": [
            "string",
            "null"
          ],
          "description": "its remapped layer in work/; null when the last stitch left it out"
        },
        "box": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "[x, y, width, height] on the panorama, in its pixels"
            },
            {
              "type": "null"
            }
          ]
        },
        "off": {
          "type": "boolean",
          "description": "turned off by the user"
        },
        "dropped": {
          "type": "boolean",
          "description": "left out by the stitch: too few control points"
        }
      },
      "required": [
        "name",
        "layer",
        "box",
        "off",
        "dropped"
      ],
      "additionalProperties": false
    },
    "Frames": {
      "type": "object",
      "description": "The photos of a curatable site.",
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Frame"
          }
        }
      },
      "required": [
        "width",
        "height",
        "frames"
      ],
      "additionalProperties": false
    },
    "BuildFrame": {
      "type": "object",
      "description": "One photo's progress through a build.",
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "enum": [
            "listed",
            "matched",
            "dropped",
            "placed",
            "off",
            "judged"
          ]
        },
        "points": {
          "type": "integer",
          "description": "control points tying it to the others"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the photos it shares control points with"
        },
        "reason": {
          "type": "string",
          "description": "why the stitch dropped it"
        },
        "layer": {
          "type": "string",
          "description": "its remapped layer in work/"
        },
        "box": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, width, height] on the panorama"
        }
      },
      "required": [
        "name",
        "state"
      ],
      "additionalProperties": false
    },
    "Pair": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "matches": {
          "type": "integer"
        }
      },
      "required": [
        "a",
        "b",
        "matches"
      ],
      "additionalProperties": false
    }
  }
}
